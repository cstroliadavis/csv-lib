{
  "name": "csv-lib",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency streaming CSV library for Bun and modern JavaScript environments",
  "type": "module",
  "license": "MIT",
  "author": "Chris Strolia-Davis <christopher.stroliadavis@gmail.com>",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:bundle && bun run build:types",
    "build:bundle": "bun build ./index.ts --outdir ./dist --target node --format esm --sourcemap=external",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
