{
  "name": "csv-lib",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency streaming CSV library for Bun and modern JavaScript environments",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:bundle && bun run build:types",
    "build:bundle": "bun build ./index.ts --outdir ./dist --target node --format esm --sourcemap=external",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "oxfmt": "^0.71.0",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.71.0"
  }
}
